# NIKKE T10 装备词条 Bot 环境变量配置
# 复制此文件为 .env 并填入实际值

# --- 数据库 ---
# SQLite 数据库文件路径（相对于项目根目录）
DATABASE_PATH=database/nikke.db

# --- 腾讯云 OCR ---
OCR_PROVIDER=tencent
TENCENT_SECRET_ID=your-secret-id-here
TENCENT_SECRET_KEY=your-secret-key-here
TENCENT_REGION=ap-guangzhou

# --- Bot 配置 ---
BOT_SUPERUSERS=["123456789"]
BOT_COMMAND_START=["/"]
BOT_NICKNAME=["妮姬助手"]

# --- OneBot WebSocket 地址（Lagrange 默认端口）---
ONEBOT_WS_URL=ws://127.0.0.1:8080/onebot/v11/ws

# --- 日志 ---
LOG_LEVEL=INFO
LOG_FILE=logs/nikke_bot.log
